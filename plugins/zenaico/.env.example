# OpenAI API Key for GPT-Image-2, DALL-E 3, and GPT-4o models
OPENAI_API_KEY=

# Google Gemini API Key
GEMINI_API_KEY=

# Plugin defaults: auto prefers Gemini when both keys are available.
# hybrid uses OpenAI for planning/review and Gemini for images.
ZENAICO_PROVIDER=auto
ZENAICO_RESOLUTION=4K
ZENAICO_ALLOW_FALLBACK=false
# Optional overrides; use models available to your provider account.
# ZENAICO_IMAGE_MODEL=gemini-3-pro-image
# ZENAICO_TEXT_MODEL=gemini-3.1-pro-preview
# Set an absolute path outside the plugin cache for persistent outputs.
# ZENAICO_OUTPUT_DIR=/absolute/path/to/visuals
# Optional screenshot support:
# ZENAICO_CHROME_PATH=/absolute/path/to/chrome
# ZENAICO_BROWSER_NO_SANDBOX=true
# Optional authenticated HTTP transport:
# ZENAICO_MCP_HOST=127.0.0.1
# ZENAICO_MCP_PORT=3333
# ZENAICO_MCP_TOKEN=your-private-token
