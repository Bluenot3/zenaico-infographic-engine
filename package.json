{
  "name": "zen-infographic-studio",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsc && vite build",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "dev:plugin": "node --import tsx plugin/src/server.ts",
    "start:plugin": "node plugins/zenaico/server.mjs",
    "start:plugin:http": "node plugins/zenaico/server.mjs --http",
    "build:plugin": "node scripts/build-plugin.mjs",
    "pack:plugin": "npm run build:plugin && node scripts/pack-plugin.mjs",
    "test:plugin": "npm run build:plugin && node --import tsx --test --experimental-test-isolation=none plugin/tests/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "^1.28.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@tailwindcss/vite": "^4.2.2",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "image-size": "^2.0.4",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "openai": "^6.49.0",
    "proxy-from-env": "^2.1.0",
    "puppeteer": "^24.40.0",
    "puppeteer-core": "^24.40.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "undici": "^7.16.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
